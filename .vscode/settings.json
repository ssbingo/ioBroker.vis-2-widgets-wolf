{
    "eslint.enable": true,
    "eslint.workingDirectories": [{ "directory": "src-widgets-ts", "changeProcessCWD": true }],
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "typescript.tsdk": "src-widgets-ts/node_modules/typescript/lib",
    "json.schemas": [
        {
            "fileMatch": ["io-package.json"],
            "url": "https://raw.githubusercontent.com/ioBroker/ioBroker.js-controller/master/schemas/io-package.json"
        }
    ],
    "files.exclude": {
        "src-widgets-ts/.__mf__temp": true
    }
}
