{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Lint",
            "type": "npm",
            "script": "lint",
            "problemMatcher": ["$eslint-stylish"]
        },
        {
            "label": "Lint: Fix",
            "type": "shell",
            "command": "npm run lint -- --fix",
            "problemMatcher": ["$eslint-stylish"]
        },
        {
            "label": "Build",
            "type": "npm",
            "script": "build",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$tsc"]
        },
        {
            "label": "Paket-Tests",
            "type": "npm",
            "script": "test",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Sandbox öffnen",
            "type": "shell",
            "command": "npm start",
            "options": { "cwd": "${workspaceFolder}/src-widgets" },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Dev-Server starten",
            "type": "shell",
            "command": "npm run dev-server watch",
            "isBackground": true,
            "problemMatcher": []
        }
    ]
}
